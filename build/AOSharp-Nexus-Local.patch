diff --git a/AOSharp.Common/IPC/AuthenticatedPacket.cs b/AOSharp.Common/IPC/AuthenticatedPacket.cs
new file mode 100644
index 0000000..1cef9f4
--- /dev/null
+++ b/AOSharp.Common/IPC/AuthenticatedPacket.cs
@@ -0,0 +1,141 @@
+using System;
+using System.Collections.Generic;
+using System.Diagnostics;
+using System.IO;
+using System.IO.MemoryMappedFiles;
+using System.Linq;
+using System.Security.AccessControl;
+using System.Security.Cryptography;
+using System.Security.Principal;
+using System.Text;
+using System.Threading;
+
+namespace AOSharp.Core.IPC
+{
+    // Nexus v1 is deliberately same-machine/current-Windows-user only. Public plugin
+    // APIs and their payloads are unchanged; legacy unsigned peers are never accepted.
+    internal sealed class AuthenticatedPacket
+    {
+        const int Header = 4 + 16 + 8 + 8, Tag = 32, MaximumSenders = 1024;
+        static readonly byte[] Magic = { 65, 79, 78, 1 };
+        readonly byte[] key, sender = Guid.NewGuid().ToByteArray();
+        readonly Func<long> now;
+        readonly long started, lifetime;
+        long sequence;
+        readonly object gate = new object();
+        sealed class Seen { internal long Sequence, At; internal ulong Window; }
+        readonly Dictionary<Guid, Seen> seen = new Dictionary<Guid, Seen>();
+        internal AuthenticatedPacket(byte[] secret, Func<long> clock = null, long frequency = 0)
+        {
+            if (secret == null || secret.Length != 32) throw new ArgumentException("IPC key must be 32 bytes.");
+            key = (byte[])secret.Clone(); now = clock ?? Stopwatch.GetTimestamp;
+            lifetime = checked((frequency == 0 ? Stopwatch.Frequency : frequency) * 5);
+            started = now();
+        }
+        internal byte[] Protect(byte[] payload)
+        {
+            if (payload == null || payload.Length < 11 || payload.Length > 65000) throw new InvalidDataException("Invalid IPC payload length.");
+            using (var stream = new MemoryStream())
+            using (var writer = new BinaryWriter(stream))
+            {
+                writer.Write(Magic); writer.Write(sender); writer.Write(Interlocked.Increment(ref sequence)); writer.Write(now()); writer.Write(payload);
+                writer.Flush(); var bytes = stream.ToArray();
+                using (var hmac = new HMACSHA256(key)) writer.Write(hmac.ComputeHash(bytes));
+                return stream.ToArray();
+            }
+        }
+        internal bool TryUnprotect(byte[] packet, out byte[] payload)
+        {
+            payload = null;
+            if (packet == null || packet.Length < Header + 11 + Tag || packet.Length > Header + 65000 + Tag) return false;
+            for (int i = 0; i < Magic.Length; i++) if (packet[i] != Magic[i]) return false;
+            byte[] expected;
+            using (var hmac = new HMACSHA256(key)) expected = hmac.ComputeHash(packet, 0, packet.Length - Tag);
+            int difference = 0;
+            for (int i = 0; i < Tag; i++) difference |= expected[i] ^ packet[packet.Length - Tag + i];
+            if (difference != 0) return false;
+            using (var reader = new BinaryReader(new MemoryStream(packet, false)))
+            {
+                reader.ReadBytes(4); Guid identity = new Guid(reader.ReadBytes(16));
+                long seq = reader.ReadInt64(), timestamp = reader.ReadInt64(), current = now();
+                if (seq <= 0 || timestamp < started || timestamp > current || current - timestamp > lifetime) return false;
+                lock (gate)
+                {
+                    if (!seen.TryGetValue(identity, out var previous))
+                    {
+                        foreach (var expired in seen.Where(pair => current - pair.Value.At > lifetime).Select(pair => pair.Key).ToArray()) seen.Remove(expired);
+                        if (seen.Count >= MaximumSenders) return false; // Never evict a still-replayable entry.
+                        previous = new Seen { Sequence = seq, At = timestamp, Window = 1 }; seen.Add(identity, previous);
+                    }
+                    else if (seq > previous.Sequence)
+                    {
+                        long shift = seq - previous.Sequence;
+                        previous.Window = shift >= 64 ? 1 : (previous.Window << (int)shift) | 1;
+                        previous.Sequence = seq; previous.At = Math.Max(previous.At, timestamp);
+                    }
+                    else
+                    {
+                        long offset = previous.Sequence - seq;
+                        if (offset >= 64 || (previous.Window & (1UL << (int)offset)) != 0) return false;
+                        previous.Window |= 1UL << (int)offset; previous.At = Math.Max(previous.At, timestamp);
+                    }
+                }
+                payload = reader.ReadBytes(packet.Length - Header - Tag);
+                return true;
+            }
+        }
+    }
+
+    internal static class LocalIpcKey
+    {
+        static readonly Lazy<byte[]> Key = new Lazy<byte[]>(Load);
+        // Holding this handle keeps the random session key alive. No key survives the
+        // last participant or a reboot, so boot-relative clocks cannot revive captures.
+        static MemoryMappedFile sharedKey;
+        internal static byte[] Get() => Key.Value;
+        static byte[] Load() => OpenSessionKey(null);
+        internal static byte[] OpenSessionKey(string testSuffix)
+        {
+            using (var identity = WindowsIdentity.GetCurrent())
+            {
+                var sid = identity.User;
+                string name = "Local\\AONexus.SecureIPC.v1." + sid.Value + (testSuffix == null ? "" : ".test." + testSuffix);
+                var mutexAccess = new MutexSecurity(); mutexAccess.SetAccessRuleProtection(true, false); mutexAccess.SetOwner(sid);
+                mutexAccess.AddAccessRule(new MutexAccessRule(sid, MutexRights.FullControl, AccessControlType.Allow));
+                bool created;
+                using (var mutex = new Mutex(false, name + ".Lock", out created, mutexAccess))
+                {
+                    bool held = false;
+                    try
+                    {
+                        if (!sid.Equals(mutex.GetAccessControl().GetOwner(typeof(SecurityIdentifier)))) throw new IOException("Unexpected IPC mutex owner.");
+                        try { held = mutex.WaitOne(TimeSpan.FromSeconds(10)); } catch (AbandonedMutexException) { held = true; }
+                        if (!held) throw new IOException("Another client is preparing secure IPC. Try again.");
+                        var access = new MemoryMappedFileSecurity(); access.SetAccessRuleProtection(true, false); access.SetOwner(sid);
+                        access.AddAccessRule(new AccessRule<MemoryMappedFileRights>(sid, MemoryMappedFileRights.FullControl, AccessControlType.Allow));
+                        var map = MemoryMappedFile.CreateOrOpen(name, 36, MemoryMappedFileAccess.ReadWrite, MemoryMappedFileOptions.None, access, HandleInheritability.None);
+                        try
+                        {
+                            if (!sid.Equals(map.GetAccessControl().GetOwner(typeof(SecurityIdentifier)))) throw new IOException("Unexpected IPC key owner.");
+                            using (var view = map.CreateViewAccessor(0, 36, MemoryMappedFileAccess.ReadWrite))
+                            {
+                                byte[] key = new byte[32]; int state = view.ReadInt32(0);
+                                if (state == 0)
+                                {
+                                    using (var random = RandomNumberGenerator.Create()) random.GetBytes(key);
+                                    view.WriteArray(4, key, 0, key.Length); view.Write(0, 1); view.Flush();
+                                }
+                                else if (state == 1) view.ReadArray(4, key, 0, key.Length);
+                                else throw new IOException("Invalid secure IPC key state.");
+                                sharedKey = map;
+                                return key;
+                            }
+                        }
+                        catch { map.Dispose(); throw; }
+                    }
+                    finally { if (held) mutex.ReleaseMutex(); }
+                }
+            }
+        }
+    }
+}
diff --git a/AOSharp.Common/PluginRuntimeStatus.cs b/AOSharp.Common/PluginRuntimeStatus.cs
new file mode 100644
index 0000000..8d9270b
--- /dev/null
+++ b/AOSharp.Common/PluginRuntimeStatus.cs
@@ -0,0 +1,78 @@
+using System;
+using System.Collections.Generic;
+using System.Diagnostics;
+using System.IO;
+using System.Linq;
+using Newtonsoft.Json;
+
+namespace AOSharp.Common
+{
+    // Optional diagnostics consumed by Nexus. A write failure must never disrupt a game callback.
+    public static class PluginRuntimeStatus
+    {
+        public sealed class Entry { public string Path, State, Error; }
+        public sealed class Conflict { public string Resource, Previous, Current; }
+        public sealed class Report
+        {
+            public int Format = 1, Pid;
+            public long StartTicks;
+            public string RequestId;
+            public List<Entry> Plugins = new List<Entry>();
+            public List<Conflict> Conflicts = new List<Conflict>();
+        }
+        static readonly object gate = new object();
+        static Report report;
+        internal static string directoryOverride;
+        [ThreadStatic] static string owner;
+        public static string Owner(string fallback) => owner ?? fallback ?? "Unknown plugin";
+        public static void SetOwner(string path) { owner = path; }
+        public static void Begin(IEnumerable<string> paths, string requestId)
+        {
+            lock (gate)
+            {
+                using (var process = Process.GetCurrentProcess()) report = new Report { Pid = process.Id, StartTicks = process.StartTime.ToUniversalTime().Ticks, RequestId = requestId };
+                foreach (string path in paths.Take(128)) report.Plugins.Add(new Entry { Path = path, State = "Requested" });
+                Save();
+            }
+        }
+        public static void State(string path, string state, Exception error = null)
+        {
+            lock (gate)
+            {
+                var entry = report?.Plugins.FirstOrDefault(item => string.Equals(item.Path, path, StringComparison.OrdinalIgnoreCase));
+                if (entry == null) return;
+                // A DLL with multiple entrypoints is failed if any one fails.
+                if (entry.State == "Failed" && state != "Stopped") return;
+                entry.State = state;
+                var cause = error?.GetBaseException();
+                entry.Error = cause == null ? null : (cause.GetType().Name + ": " + cause.Message);
+                if (entry.Error?.Length > 1000) entry.Error = entry.Error.Substring(0, 1000);
+                Save();
+            }
+        }
+        public static void ClaimConflict(string resource, string previous, string current)
+        {
+            lock (gate)
+            {
+                if (report == null || report.Conflicts.Count >= 128) return;
+                if (report.Conflicts.Any(item => item.Resource == resource && item.Previous == previous && item.Current == current)) return;
+                report.Conflicts.Add(new Conflict { Resource = resource, Previous = previous, Current = current }); Save();
+            }
+        }
+        static void Save()
+        {
+            string temporary = null;
+            try
+            {
+                string folder = directoryOverride ?? Path.Combine(Environment.GetFolderPath(Environment.SpecialFolder.LocalApplicationData), "AONexus", "PluginRuntime");
+                Directory.CreateDirectory(folder);
+                string file = Path.Combine(folder, report.Pid + "-" + report.StartTicks + ".json");
+                temporary = file + "." + Guid.NewGuid().ToString("N") + ".tmp";
+                File.WriteAllText(temporary, JsonConvert.SerializeObject(report));
+                if (File.Exists(file)) File.Replace(temporary, file, null); else File.Move(temporary, file);
+            }
+            catch (Exception ex) { Debug.WriteLine("Nexus runtime status: " + ex.Message); }
+            finally { try { if (temporary != null && File.Exists(temporary)) File.Delete(temporary); } catch { } }
+        }
+    }
+}
